# ==========================================
# TERA ATACADO - APACHE
# ==========================================

Options -Indexes

RewriteEngine On


# ==========================================
# BLOQUEAR ARQUIVOS SENSÍVEIS
# ==========================================

<FilesMatch "^(\.env|\.env\..*|\.gitignore|\.htaccess|docker-compose\.yml|Dockerfile|README\.md|LICENSE)$">
    Require all denied
</FilesMatch>


# ==========================================
# BLOQUEAR ARQUIVOS OCULTOS
# ==========================================

<FilesMatch "^\.">
    Require all denied
</FilesMatch>


# ==========================================
# BLOQUEAR ARQUIVOS DE CONFIGURAÇÃO/BACKUP
# ==========================================

<FilesMatch "\.(sql|log|ini|conf|bak|backup|old)$">
    Require all denied
</FilesMatch>


# ==========================================
# BLOQUEAR PASTAS INTERNAS
# ==========================================

# Bloquear o Back_end, exceto o processamento de entrada
RewriteRule ^Back_end/(?!processamentos/(?:registrar_entrada|consultar_estoque|registrar_saida)\.php$).* - [F,L]

# Bloquear as demais pastas internas
RewriteRule ^Database(?:/|$) - [F,L]
RewriteRule ^Docker(?:/|$) - [F,L]
RewriteRule ^Python(?:/|$) - [F,L]